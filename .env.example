# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Security
JWT_SECRET=change_me_to_long_random_secret
ADMIN_SETUP_KEY=change_me_bootstrap_key
CORS_ORIGIN=http://localhost:3001
EASYTAXI_WEBHOOK_SECRET=change_me_easytaxi_webhook_secret
OPENCLAW_WEBHOOK_SECRET=change_me_openclaw_webhook_secret

# Database (PostgreSQL)
DATABASE_URL=postgresql://riderra:riderra_local_password@localhost:55432/riderra?schema=public

# Integrations
SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_MAPS_API_KEY=
GOOGLE_MY_MAPS_ID=
GEOCODING_PROVIDER=google_maps
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_GROUP_CHAT_ID=

# Email
EMAIL_TO=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# GigaChat semantic place matching (recommendations only; never auto-approves)
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_CA_BUNDLE=
GIGACHAT_SSL_VERIFY=true
PRICING_EMBEDDINGS_ENABLED=false
PRICING_EMBEDDINGS_MODEL=EmbeddingsGigaR
PRICING_EMBEDDINGS_BASE_URL=https://api.giga.chat/v1

# PostgreSQL local defaults (docker-compose)
POSTGRES_DB=riderra
POSTGRES_USER=riderra
POSTGRES_PASSWORD=riderra_local_password
