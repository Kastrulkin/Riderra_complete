  assignedToUser     User?                      @relation("ComplaintAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages           ComplaintMessage[]
  activities         ComplaintActivity[]
  evidence           ComplaintEvidence[]
  contractRule       CounterpartyComplaintRule? @relation(fields: [contractRuleId], references: [id], onDelete: SetNull)

  @@unique([tenantId, externalThreadId], map: "uq_complaint_thread")
  @@index([tenantId, status, firstResponseDueAt])
  @@index([tenantId, assignedToUserId, status])
  @@index([tenantId, orderId, updatedAt])
}

model CounterpartyComplaintRule {
  id                       String          @id @default(cuid())
  tenantId                 String
  counterpartyName         String
  title                    String
  version                  Int             @default(1)
  isActive                 Boolean         @default(true)
  waitingMinutes           Int?
  arrivalToleranceMin      Int?
  requiredActionsJson      String?
  approvedStatementsJson   String?
  prohibitedStatementsJson String?
  sourceDocumentName       String?
  sourceObjectKey          String?
  notes                    String?
  createdByUserId          String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  tenant                   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  complaints               ComplaintCase[]

  @@unique([tenantId, counterpartyName, version], map: "uq_counterparty_complaint_rule_version")
  @@index([tenantId, counterpartyName, isActive])
}

model ComplaintMessage {
  id                String        @id @default(cuid())
  tenantId          String
  complaintId       String
  direction         String        @default("inbound") // inbound, outbound
  externalMessageId String?
  externalThreadId  String?
  sender            String?
  recipientsJson    String?
  subject           String?
  bodyText          String
  attachmentsJson   String?
  providerMessageId String?
  deliveryStatus    String?
  deliveryError     String?
  approvalStatus    String?
  idempotencyKey    String?
  createdByUserId   String?
  sentAt            DateTime?
  createdAt         DateTime      @default(now())
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  complaint         ComplaintCase @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalMessageId], map: "uq_complaint_message_external")
  @@unique([tenantId, idempotencyKey], map: "uq_complaint_message_idempotency")
  @@index([complaintId, createdAt])
}

model ComplaintActivity {
  id           String        @id @default(cuid())
  tenantId     String
  complaintId  String
  type         String // created, status_changed, assigned, note, matched, evidence_added, response_prepared, response_sent
  title        String
  details      String?
  actorUserId  String?
  actorEmail   String?
  metadataJson String?
  createdAt    DateTime      @default(now())
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  complaint    ComplaintCase @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([tenantId, complaintId, createdAt])
}

model ComplaintEvidence {
  id              String        @id @default(cuid())
  tenantId        String
  complaintId     String
  type            String // email_attachment, tracking_csv, document, internal_note
  title           String
  contentText     String?
  objectKey       String?
  mimeType        String?
  filename        String?
  size            Int?
  source          String?
  metadataJson    String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  complaint       ComplaintCase @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([tenantId, complaintId, createdAt])
}

model ProviderTripEvent {
  id              String   @id @default(cuid())
  tenantId        String
  orderId         String
  provider        String   @default("easytaxi")
  externalEventId String
  eventType       String
  occurredAt      DateTime
  driverName      String?
  latitude        Float?
  longitude       Float?
  source          String   @default("api") // api, webhook, csv, manual
  payloadJson     String?
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalEventId], map: "uq_provider_trip_event")
  @@index([tenantId, orderId, occurredAt])
}

model ChatAgentConfig {
  id               String                @id @default(cuid())
  tenantId         String
  code             String
  name             String
  type             String                @default("order_completion")
  description      String?
  personality      String?
  identity         String?
  task             String?
  speechStyle      String?
  taskType         String                @default("clarification")
  promptText       String
  workflowJson     String?
  workflowFormat   String                @default("json")
  restrictionsJson String?
  constraintsJson  String?
  variablesJson    String?
  isActive         Boolean               @default(true)
  requiresApproval Boolean               @default(true)
  createdByUserId  String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chatTasks        ChatTask[]
  learningEvents   AiLearningEvent[]
  versions         ChatAgentVersion[]
  runs             AgentRun[]
  sandboxSessions  AgentSandboxSession[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive, updatedAt])
}

model ChatAgentVersion {
  id              String                @id @default(cuid())
  tenantId        String
  agentConfigId   String
  version         Int
  status          String                @default("draft") // draft, tested, published, archived
  snapshotJson    String
  testSummaryJson String?
  testedAt        DateTime?
  publishedAt     DateTime?
  archivedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentConfig     ChatAgentConfig       @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)
  chatTasks       ChatTask[]
  runs            AgentRun[]
  sandboxSessions AgentSandboxSession[]

  @@unique([agentConfigId, version])
  @@index([tenantId, status, updatedAt])
}

model AgentRun {
  id                   String               @id @default(cuid())
  tenantId             String
  agentConfigId        String?
  agentConfigVersionId String?
  chatTaskId           String?
  sandboxSessionId     String?
  capability           String
  status               String               @default("queued") // queued, running, waiting_approval, completed, failed, fallback
  stateBefore          String?
  stateAfter           String?
  provider             String?
  model                String?
  summary              String?
  inputJson            String?
  outputJson           String?
  errorText            String?
  latencyMs            Int?
  startedAt            DateTime             @default(now())
  finishedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentConfig          ChatAgentConfig?     @relation(fields: [agentConfigId], references: [id], onDelete: SetNull)
  agentConfigVersion   ChatAgentVersion?    @relation(fields: [agentConfigVersionId], references: [id], onDelete: SetNull)
  chatTask             ChatTask?            @relation(fields: [chatTaskId], references: [id], onDelete: SetNull)
  sandboxSession       AgentSandboxSession? @relation(fields: [sandboxSessionId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, startedAt])
  @@index([agentConfigId, startedAt])
  @@index([chatTaskId, startedAt])
}

model AgentSandboxSession {
  id                   String                @id @default(cuid())
  tenantId             String
  agentConfigId        String
  agentConfigVersionId String?
  status               String                @default("active") // active, passed, failed, closed
  scenarioKey          String?
  currentState         String
  initialContextJson   String?
  resultSummaryJson    String?
  passed               Boolean?
  createdByUserId      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  completedAt          DateTime?
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentConfig          ChatAgentConfig       @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)
  agentConfigVersion   ChatAgentVersion?     @relation(fields: [agentConfigVersionId], references: [id], onDelete: SetNull)
  messages             AgentSandboxMessage[]
  runs                 AgentRun[]

  @@index([tenantId, status, updatedAt])
  @@index([agentConfigId, updatedAt])
}

model AgentSandboxMessage {
  id             String              @id @default(cuid())
  sessionId      String
  role           String // customer, agent, operator, system
  bodyText       String
  stateBefore    String?
  stateAfter     String?
  extractionJson String?
  traceJson      String?
  createdAt      DateTime            @default(now())
  session        AgentSandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model PromptTemplate {
  id          String                  @id @default(cuid())
  tenantId    String
  key         String
  title       String
  description String?
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions    PromptTemplateVersion[]

  @@unique([tenantId, key])
  @@index([tenantId, isActive, updatedAt])
}

model PromptTemplateVersion {
  id              String         @id @default(cuid())
  templateId      String
  version         Int
  content         String
  notes           String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  createdByUserId String?
  template        PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId, isActive, createdAt])
}

model AiLearningEvent {
  id               String           @id @default(cuid())
  tenantId         String
  createdAt        DateTime         @default(now())
  agentConfigId    String?
  chatTaskId       String?
  chatMessageId    String?
  promptKey        String?
  promptVersion    Int?
  capability       String
  intent           String
  outcome          String
  editedBeforeSend Boolean?
  responseTimeMs   Int?
  contextJson      String?
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentConfig      ChatAgentConfig? @relation(fields: [agentConfigId], references: [id], onDelete: SetNull)
  chatTask         ChatTask?        @relation(fields: [chatTaskId], references: [id], onDelete: SetNull)
  chatMessage      ChatMessage?     @relation(fields: [chatMessageId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, capability, createdAt])
  @@index([tenantId, outcome, createdAt])
}

model Role {
  id          String           @id @default(cuid())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  code        String           @unique
  name        String
  links       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  code      String           @unique
  name      String
  roles     RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model TelegramLink {
  id             String   @id @default(cuid())
  tenantId       String?
  createdAt      DateTime @default(now())
  userId         String
  telegramUserId String   @unique
  telegramChatId String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([userId, telegramUserId])
  @@index([tenantId, userId])
  @@index([userId])
}
