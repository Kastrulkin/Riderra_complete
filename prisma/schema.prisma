generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                            String                          @id @default(cuid())
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  code                          String                          @unique
  name                          String
  isActive                      Boolean                         @default(true)
  memberships                   TenantMembership[]
  idempotencyKeys               IdempotencyKey[]
  auditLogs                     AuditLog[]
  approvals                     HumanApproval[]
  orders                        Order[]
  orderQualitySignals           OrderQualitySignal[]
  orderStatusEvents             OrderStatusHistory[]
  orderChangeLogs               OrderChangeLog[]
  pricingRows                   CityPricing[]
  counterpartyRules             CounterpartyPriceRule[]
  drivers                       Driver[]
  driverRoutes                  DriverRoute[]
  cityRoutes                    CityRoute[]
  driverCityRoutes              DriverCityRoute[]
  requests                      Request[]
  reviews                       Review[]
  customerCompanies             CustomerCompany[]
  customerContacts              CustomerContact[]
  crmCompanies                  CrmCompany[]
  crmContacts                   CrmContact[]
  opsEventDrafts                OpsEventDraft[]
  opsEvents                     OpsEvent[]
  driverBlocks                  DriverUnavailability[]
  opsTasks                      OpsTask[]
  orderAdjustments              OrderAdjustment[]
  telegramLinks                 TelegramLink[]
  fleetVehicles                 FleetVehicle[]
  chatTasks                     ChatTask[]
  chatMessages                  ChatMessage[]
  chatAgentConfigs              ChatAgentConfig[]
  chatAgentVersions             ChatAgentVersion[]
  agentRuns                     AgentRun[]
  agentSandboxSessions          AgentSandboxSession[]
  promptTemplates               PromptTemplate[]
  aiLearningEvents              AiLearningEvent[]
  vpnProfiles                   VpnProfile[]
  vpnAccessGrants               VpnAccessGrant[]
  wikiPages                     WikiPage[]
  complaintCases                ComplaintCase[]
  complaintMessages             ComplaintMessage[]
  complaintActivities           ComplaintActivity[]
  complaintEvidence             ComplaintEvidence[]
  providerTripEvents            ProviderTripEvent[]
  complaintRules                CounterpartyComplaintRule[]
  priceComparisonSources        PriceComparisonSource[]
  priceComparisonRuns           PriceComparisonRun[]
  priceComparisonQuotes         PriceComparisonQuote[]
  priceComparisonResults        PriceComparisonResult[]
  priceComparisonPlaces         PriceComparisonPlaceMap[]
  priceComparisonVehicles       PriceComparisonVehicleMap[]
  externalPriceSnapshots        ExternalTransferPriceSnapshot[]
  externalCatalogCrawls         ExternalPriceCatalogCrawl[]
  externalCatalogRoutes         ExternalPriceCatalogRoute[]
  geoZoneBenchmarkPoints        GeoZoneBenchmarkPoint[]
  canonicalTransferPlaces       CanonicalTransferPlace[]
  canonicalTransferPlaceAliases CanonicalTransferPlaceAlias[]
}

model TenantMembership {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  userId    String
  role      String   @default("staff")
  isActive  Boolean  @default(true)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, isActive])
}

// Пользователи системы (админы и водители)
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String // Хешированный пароль
  role          String   @default("driver") // admin, driver
  isActive      Boolean  @default(true)
  abacCountries String?
  abacCities    String?
  abacTeams     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Связь с водителем (если роль = driver)
  driver             Driver?
  roleLinks          UserRole[]
  telegramLinks      TelegramLink[]
  opsTasks           OpsTask[]          @relation("OpsTaskAssignee")
  memberships        TenantMembership[]
  assignedComplaints ComplaintCase[]    @relation("ComplaintAssignee")

  @@map("users")
}

model Request {
  id         String    @id @default(cuid())
  tenantId   String?
  createdAt  DateTime  @default(now())
  name       String
  email      String
  phone      String
  fromPoint  String
  toPoint    String
  date       DateTime?
  passengers Int?
  luggage    Int?
  comment    String?
  lang       String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model WikiPage {
  id              String     @id @default(cuid())
  tenantId        String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  importedAt      DateTime?
  title           String
  slug            String
  contentMarkdown String     @default("")
  contentText     String     @default("")
  sourceProvider  String     @default("manual")
  sourcePageId    String?
  sourceUrl       String?
  sourceUpdatedAt DateTime?
  parentId        String?
  sortOrder       Int        @default(0)
  isPublished     Boolean    @default(true)
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent          WikiPage?  @relation("WikiPageChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children        WikiPage[] @relation("WikiPageChildren")

  @@unique([tenantId, sourceProvider, sourcePageId])
  @@index([tenantId, isPublished, updatedAt])
  @@index([tenantId, parentId, sortOrder])
  @@index([tenantId, slug])
}

model Driver {
  id                String   @id @default(cuid())
  tenantId          String?
  createdAt         DateTime @default(now())
  name              String
  email             String?
  phone             String
  supplierContactId String?
  supplierCompanyId String?
  country           String?
  city              String
  telegramUserId    String?
  fixedFrom         String?
  fixedTo           String?
  fixedPrice        String?
  fixedCurrency     String?
  pricePerKm        String?
  comment           String?
  lang              String?
  fixedRoutesJson   String?

  // Новые поля для системы комиссий
  commissionRate     Float?   @default(15.0) // Комиссия водителя (5-30%)
  isActive           Boolean  @default(false) // Активен ли водитель
  verificationStatus String   @default("pending") // pending, verified, rejected
  rating             Float?   @default(5.0) // Рейтинг водителя (1-5)
  totalTrips         Int      @default(0) // Количество поездок
  totalReviews       Int      @default(0) // Количество отзывов
  avgRating          Float?   @default(5.0) // Средний рейтинг из отзывов
  kmRate             Float? // Стоимость за км (если есть)
  hourlyRate         Float? // Почасовая ставка (если есть)
  childSeatPrice     Float? // Стоимость детского кресла (если есть)
  pricingCurrency    String? // Валюта тарифов
  updatedAt          DateTime @updatedAt

  // Связь с пользователем
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Связь с маршрутами
  routes           DriverRoute[]
  // Связь с заказами
  orders           Order[]
  orderAdjustments OrderAdjustment[]
  // Связь с отзывами
  reviews          Review[]
  // Связь с предустановленными маршрутами городов
  cityRoutes       DriverCityRoute[]
  unavailability   DriverUnavailability[]
  vehicles         FleetVehicle[]
  supplierContact  CustomerContact?       @relation("SupplierContactDriverLink", fields: [supplierContactId], references: [id], onDelete: SetNull)
  supplierCompany  CustomerCompany?       @relation("SupplierCompanyDriverLink", fields: [supplierCompanyId], references: [id], onDelete: SetNull)
  tenant           Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, country, city])
  @@index([country, city])
  @@index([telegramUserId])
  @@index([tenantId, supplierContactId])
  @@index([tenantId, supplierCompanyId])
}

model FleetVehicle {
  id             String   @id @default(cuid())
  tenantId       String?
  driverId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  vehicleClass   String
  brand          String?
  model          String?
  plateNumber    String
  productionYear Int?
  color          String?
  seats          Int?
  notes          String?
  isActive       Boolean  @default(true)
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  driver         Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([tenantId, vehicleClass, isActive])
  @@index([tenantId, driverId, isActive])
  @@index([tenantId, plateNumber])
}

model DriverRoute {
  id             String    @id @default(cuid())
  tenantId       String?
  driverId       String
  driver         Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  fromPoint      String
  toPoint        String
  vehicleType    String?
  driverPrice    Float // Цена водителя
  ourPrice       Float? // Наша целевая цена
  currency       String    @default("EUR")
  sourceType     String? // whatsapp, email, call, manual, sheet
  sourceLabel    String?
  sourceQuotedAt DateTime?
  sourceMessage  String?
  sourceStatus   String    @default("approved") // approved, pending_clarification, archived
  sourceMetaJson String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, driverId, isActive])
  @@index([tenantId, vehicleType, isActive])
}

model Order {
  id                        String    @id @default(cuid())
  tenantId                  String?
  createdAt                 DateTime  @default(now())
  source                    String    @default("internal") // internal, easytaxi, google_sheet
  externalKey               String?   @unique // Уникальный ключ заказа во внешней системе
  sourceRow                 Int? // Номер строки в исходной таблице
  pickupAt                  DateTime? // Дата и время подачи
  fromPoint                 String
  toPoint                   String
  clientPrice               Float // Цена для клиента (от EasyTaxi)
  driverPrice               Float? // Цена водителя
  commission                Float? // Комиссия платформы
  driverId                  String? // ID назначенного водителя
  driver                    Driver?   @relation(fields: [driverId], references: [id])
  status                    String    @default("pending") // pending, assigned, accepted, completed, cancelled
  vehicleType               String // Тип транспорта
  counterpartyName          String?
  driverNameRaw             String?
  sourceComment             String?
  sourceCurrency            String?
  sourceCityCode            String?
  sourceVehicleCode         String?
  sourceDirection           String?
  sourceOrderNumber         String?
  sourceBookingId           String?
  sourceInternalOrderNumber String?
  customerName              String?
  customerEmail             String?
  customerPhone             String?
  manualOverridesJson       String?
  hasComplaint              Boolean   @default(false)
  issueFlagsJson            String?
  passengers                Int?
  luggage                   Int?
  needsInfo                 Boolean   @default(false)
  infoReason                String?
  flightNumber              String?
  flightStatus              String?
  flightProvider            String?
  flightCheckedAt           DateTime?
  flightArrivalScheduled    DateTime?
  flightArrivalEstimated    DateTime?
  flightArrivalActual       DateTime?
  flightVerificationJson    String?
  addressProvider           String?
  addressCheckedAt          DateTime?
  fromPointNormalized       String?
  fromPointLat              Float?
  fromPointLon              Float?
  toPointNormalized         String?
  toPointLat                Float?
  toPointLon                Float?
  addressVerificationJson   String?
  comment                   String?
  lang                      String?
  updatedAt                 DateTime  @updatedAt

  // Связь с отзывами
  reviews            Review[]
  sourceHistory      OrderSourceSnapshot[]
  priceConflicts     PriceConflict[]
  adjustments        OrderAdjustment[]
  statusHistory      OrderStatusHistory[]
  changeLogs         OrderChangeLog[]
  chatTasks          ChatTask[]
  qualitySignals     OrderQualitySignal[]
  complaintCases     ComplaintCase[]
  providerTripEvents ProviderTripEvent[]
  tenant             Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, counterpartyName])
  @@index([tenantId, driverNameRaw])
  @@index([tenantId, sourceCurrency])
}

model OrderChangeLog {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  actorUserId String?
  actorEmail  String?
  actorRole   String?
  reason      String?
  changesJson String
  beforeJson  String
  afterJson   String
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId, createdAt])
  @@index([tenantId, actorUserId, createdAt])
}

model OrderQualitySignal {
  id         String   @id @default(cuid())
  tenantId   String?
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String
  severity   String   @default("medium")
  source     String   @default("rule")
  text       String?
  confidence Float    @default(1.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([orderId, type, source])
  @@index([tenantId, type, severity])
  @@index([tenantId, orderId])
}

model OrderAdjustment {
  id                String           @id @default(cuid())
  tenantId          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  orderId           String?
  order             Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  driverId          String?
  driver            Driver?          @relation(fields: [driverId], references: [id], onDelete: SetNull)
  customerCompanyId String?
  customerCompany   CustomerCompany? @relation(fields: [customerCompanyId], references: [id], onDelete: SetNull)
  type              String           @default("penalty") // penalty, bonus, correction
  amount            Float?
  currency          String           @default("EUR")
  reason            String?
  counterpartyName  String?
  driverNameRaw     String?
  source            String           @default("google_sheet")
  sourceKey         String?          @unique
  sourceSheetId     String?
  sourceTabName     String?
  sourceRow         Int?
  rawText           String?
  rawPayload        String?
  isActive          Boolean          @default(true)
  tenant            Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, type, isActive, createdAt])
  @@index([tenantId, driverId, isActive])
  @@index([tenantId, customerCompanyId, isActive])
  @@index([tenantId, counterpartyName, isActive])
  @@index([orderId, isActive])
}

model VpnProfile {
  id          String           @id @default(cuid())
  tenantId    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  name        String           @default("Corporate VPN")
  serverHost  String
  serverPort  Int              @default(443)
  protocol    String           @default("vless")
  security    String           @default("reality")
  transport   String           @default("tcp")
  flow        String           @default("xtls-rprx-vision")
  publicKey   String
  shortId     String
  serverName  String
  fingerprint String?          @default("chrome")
  isActive    Boolean          @default(true)
  notes       String?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accesses    VpnAccessGrant[]

  @@unique([tenantId])
  @@index([tenantId, updatedAt])
}

model VpnAccessGrant {
  id              String      @id @default(cuid())
  tenantId        String
  profileId       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  issuedAt        DateTime    @default(now())
  disabledAt      DateTime?
  rotatedAt       DateTime?
  employeeName    String
  employeeEmail   String?
  employeeLogin   String?
  deviceKind      String?
  deviceName      String
  platform        String?
  uuid            String      @unique
  status          String      @default("pending")
  comment         String?
  connectionLabel String?
  syncState       String      @default("pending")
  appliedAt       DateTime?
  lastSyncError   String?
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile         VpnProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, updatedAt])
  @@index([tenantId, employeeEmail])
  @@index([tenantId, employeeLogin])
}

model OrderStatusHistory {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  orderId     String
  tenantId    String?
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  String
  toStatus    String
  reason      String?
  actorUserId String?
  actorEmail  String?
  source      String   @default("system")
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([source, createdAt])
  @@index([tenantId, createdAt])
}

model Review {
  id         String   @id @default(cuid())
  tenantId   String?
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  rating     Int // 1-5 звезд
  comment    String?
  clientName String? // Имя клиента (опционально)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([orderId]) // Один отзыв на заказ (для admin-отзывов orderId = null)
  @@index([tenantId, createdAt])
  @@index([tenantId, driverId, createdAt])
}

// Предустановленные маршруты по городам (общие для всех водителей)
model CityRoute {
  id          String   @id @default(cuid())
  tenantId    String?
  country     String // Страна
  city        String // Город
  fromPoint   String // Откуда
  toPoint     String // Куда
  vehicleType String // Класс машины
  passengers  Int // Количество пассажиров
  distance    Float // Расстояние в километрах
  targetFare  Float // Целевая стоимость
  currency    String   @default("EUR") // Валюта
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Связь с индивидуальными ценами водителей
  driverPrices DriverCityRoute[]
  tenant       Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, country, city, isActive])
  @@map("city_routes")
}

// Индивидуальные цены водителей для предустановленных маршрутов
model DriverCityRoute {
  id             String    @id @default(cuid())
  tenantId       String?
  driverId       String
  driver         Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  cityRouteId    String
  cityRoute      CityRoute @relation(fields: [cityRouteId], references: [id], onDelete: Cascade)
  bestPrice      Float? // Ваше лучшее предложение (может быть null, если водитель еще не указал)
  sourceType     String? // whatsapp, email, call, manual, sheet
  sourceLabel    String?
  sourceQuotedAt DateTime?
  sourceMessage  String?
  sourceStatus   String    @default("approved") // approved, pending_clarification, archived
  sourceMetaJson String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([driverId, cityRouteId]) // Одна цена водителя на маршрут
  @@index([tenantId, driverId, cityRouteId])
  @@map("driver_city_routes")
}

model SheetSource {
  id             String                @id @default(cuid())
  tenantId       String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  name           String
  monthLabel     String // Например 2025-01
  googleSheetId  String
  tabName        String                @default("таблица")
  detailsTabName String                @default("подробности")
  columnMapping  String? // JSON-словарь: canonicalField -> sheetHeader
  isActive       Boolean               @default(true)
  syncEnabled    Boolean               @default(true)
  lastSyncAt     DateTime?
  lastSyncStatus String? // success, failed
  lastSyncError  String?
  snapshots      OrderSourceSnapshot[]
}

model OrderSourceSnapshot {
  id            String      @id @default(cuid())
  tenantId      String?
  createdAt     DateTime    @default(now())
  orderId       String?
  order         Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sheetSourceId String
  sheetSource   SheetSource @relation(fields: [sheetSourceId], references: [id], onDelete: Cascade)
  sourceRow     Int
  rowHash       String
  rawPayload    String // JSON строка исходной строки

  @@index([sheetSourceId, sourceRow])
  @@index([tenantId, createdAt])
}

model CrmCompany {
  id              String              @id @default(cuid())
  tenantId        String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  sourceSystem    String              @default("planfix")
  externalId      String
  name            String
  website         String?
  phone           String?
  email           String?
  telegramUrl     String?
  countryPresence String?
  cityPresence    String?
  comment         String?
  ownerName       String?
  companyType     String?
  extraInfo       String?
  links           CrmCompanyContact[]
  segments        CrmCompanySegment[]
  tenant          Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([sourceSystem, externalId])
  @@index([tenantId, updatedAt])
}

model CrmContact {
  id              String              @id @default(cuid())
  tenantId        String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  sourceSystem    String              @default("planfix")
  externalId      String
  fullName        String
  website         String?
  phone           String?
  email           String?
  telegramUrl     String?
  countryPresence String?
  cityPresence    String?
  comment         String?
  position        String?
  ownerName       String?
  links           CrmCompanyContact[]
  segments        CrmContactSegment[]
  tenant          Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([sourceSystem, externalId])
  @@index([tenantId, updatedAt])
}

model CrmCompanyContact {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  companyId String
  contactId String
  source    String     @default("planfix")
  matchType String? // external_id, company_name, contact_name
  company   CrmCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact   CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([companyId, contactId])
  @@index([contactId])
}

model CrmCompanySegment {
  id         String     @id @default(cuid())
  createdAt  DateTime   @default(now())
  companyId  String
  segment    String
  sourceFile String
  company    CrmCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, segment])
}

model CrmContactSegment {
  id         String     @id @default(cuid())
  createdAt  DateTime   @default(now())
  contactId  String
  segment    String
  sourceFile String
  contact    CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, segment])
}

model CustomerCompany {
  id                  String                   @id @default(cuid())
  tenantId            String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  sourceSystem        String                   @default("planfix")
  externalId          String
  name                String
  website             String?
  phone               String?
  email               String?
  telegramUrl         String?
  registrationCountry String?
  registrationCity    String?
  registrationAddress String?
  presenceCountries   String?
  presenceCities      String?
  countryPresence     String?
  cityPresence        String?
  comment             String?
  ownerName           String?
  companyType         String?
  extraInfo           String?
  links               CustomerCompanyContact[]
  segments            CustomerCompanySegment[]
  pricingRules        CounterpartyPriceRule[]
  orderAdjustments    OrderAdjustment[]
  comparisonSources   PriceComparisonSource[]
  bestSupplierPricingRows CityPricing[]             @relation("CityPricingBestSupplier")
  supplierDrivers     Driver[]                 @relation("SupplierCompanyDriverLink")
  tenant              Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([sourceSystem, externalId])
  @@index([name])
  @@index([tenantId, updatedAt])
}

model CustomerContact {
  id                  String                   @id @default(cuid())
  tenantId            String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  sourceSystem        String                   @default("planfix")
  externalId          String
  fullName            String
